{
    "name":  "dsh-mobile-connect",
    "version":  "3.0.0",
    "description":  "Phone gateway for DeepSeek Harness \u0026 multi-agent CLIs (DSH / Antigravity / Claude Code / Codex / OpenCode): HTTP/SSE + Noise_IK E2EE API and QR pairing.",
    "type":  "module",
    "engines":  {
                    "node":  "^22.19.0 || \u003e=24.0.0",
                    "dsh":  "^0.2.1-rc.1"
                },
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "inject":  [
                                              "@deepseek-ai/dsh-client-locale",
                                              "@deepseek-ai/dsh-client-ui-settings"
                                          ],
                               "platform":  "web"
                           }
            },
    "dependencies":  {
                         "qrcode":  "^1.5.4"
                     },
    "files":  [
                  "lib",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "LICENSE"
              ],
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "mobile",
                     "gateway"
                 ],
    "license":  "MIT"
}
